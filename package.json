{
  "name": "vsgh-website",
  "version": "0.1.0",
  "private": true,
  "description": "VSGH external corporate website — implementation repository (WP03 Rev B).",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
