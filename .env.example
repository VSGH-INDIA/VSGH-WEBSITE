# Names only. Never commit real secrets (VSGH-CURSOR-011 / WEB-051).
# Copy to .env.local for local development.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity Content Lake (WEB-043). Leave project id blank until a VSGH project exists.
# Project id and dataset are not secrets. Tokens and webhook secrets are secrets — server only.
# Never prefix SANITY_API_READ_TOKEN, SANITY_REVALIDATE_SECRET, or SANITY_PREVIEW_SECRET with NEXT_PUBLIC_.
# Studio is a separate process (`npm run studio` on port 3333), not a www.vsgh.com route.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-08-19
SANITY_STUDIO_PROJECT_ID=
# Optional. Not used for published public-dataset reads. Required only for unused previewDrafts client
# if the dataset is private. Minimum 32 characters when set. Viewer/read-only scope.
SANITY_API_READ_TOKEN=
# Webhook and preview secrets: generate long random values (>= 32 characters) in the host secret store.
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=
