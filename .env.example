# Names only. Never commit real secrets (VSGH-CURSOR-011 / WEB-051).
# Copy to .env.local for local development.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project id and dataset are public identifiers, not secrets.
# Tokens and webhook/preview secrets are secrets — server only.
# Never prefix SANITY_API_READ_TOKEN, SANITY_REVALIDATE_SECRET, or SANITY_PREVIEW_SECRET with NEXT_PUBLIC_.
# Studio is a separate process (`npm run studio` on port 3333), not a vsghindia.com route.
# Production canonical origin is SITE_ORIGIN (https://vsghindia.com), not this local URL.
# Fallback if these are unset: src/sanity/project.ts → 9fys33s1 / production (verified VSGH-WEBSITE project).
NEXT_PUBLIC_SANITY_PROJECT_ID=9fys33s1
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-08-19
SANITY_STUDIO_PROJECT_ID=9fys33s1
# Studio-only preview helper (not a Next public var). Same value as SANITY_PREVIEW_SECRET when used.
# Origin permitted to frame an authenticated draft-only Presentation preview.
# The hosted Studio defaults to https://vsgh-india-cms.sanity.studio when unset.
SANITY_STUDIO_ORIGIN=https://vsgh-india-cms.sanity.studio
SANITY_STUDIO_PREVIEW_ORIGIN=
SANITY_STUDIO_PREVIEW_SECRET=
# Viewer/read-only. Required for draft preview (previewDrafts). Not used for published public reads.
# Minimum 32 characters when set.
SANITY_API_READ_TOKEN=
# Webhook and preview secrets: generate long random values (>= 32 characters) in the host secret store.
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=

# Contact delivery. All server-only; use an approved sender domain in Resend.
CONTACT_EMAIL_PROVIDER=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Required for production contact abuse protection. Upstash REST credentials stay server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile. The site key is public; the secret is server-only.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional public search verification values.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
