# Names only. Never commit real secrets (VSGH-CURSOR-011 / WEB-051).
# Copy to .env.local for local development.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity Content Lake (WEB-043). Leave project id blank until a VSGH project exists.
# Project id and dataset are not secrets. Tokens are secrets — server only.
# Studio is a separate process (`npm run studio` on port 3333), not a www.vsgh.com route.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-08-19
SANITY_STUDIO_PROJECT_ID=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=
