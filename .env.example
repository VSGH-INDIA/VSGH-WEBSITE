# Names only. Never commit real secrets (VSGH-CURSOR-011 / WEB-051).
# Copy to .env.local for local development.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity Content Lake (WEB-043). Leave blank until a VSGH Sanity project exists.
# Studio must not be mounted as a public www.vsgh.com route.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
